# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and weights
checkpoints/
checkpoints_ssh/
*.pt
*.pth
*.ckpt

# Cached and raw data (prevent uploading gigabytes of data files)
data/*.npz
data/
*.mat

# Experiment logs and generated outputs
outputs/
outputs_ssh/
*.log

# Environments
.env
.venv
env/
venv/
ENV/

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# LaTeX generated artifacts (binaries and build artifacts)
# Source files (.tex, .bib) ARE tracked for reproducibility (ICML 2027)
report_latex/*.pdf
report_latex/*.png
report_latex/*.aux
report_latex/*.bbl
report_latex/*.blg
report_latex/*.out
report_latex/*.log
report_latex/*.fls
report_latex/*.fdb_latexmk
report_latex/*.synctex.gz
